# minicoder 配置样例 —— 复制为 .env 并填入你的值
# minicoder 启动时会自动加载项目根目录下的 .env

# Provider 选择:openai | anthropic
MINICODER_PROVIDER=openai

# --- OpenAI 兼容后端(OpenAI / DeepSeek / Ollama / Kimi / Qwen ...) ---
OPENAI_API_KEY=sk-xxx
# 换后端只需改 base_url,例如:
#   DeepSeek:  https://api.deepseek.com/v1
#   Ollama:    http://localhost:11434/v1  (API key 随便填)
#   Kimi:      https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic 后端 ---
ANTHROPIC_API_KEY=sk-ant-xxx

# 模型覆盖(留空则按 provider 用默认:openai=gpt-4o, anthropic=claude-sonnet-4-5)
# MINICODER_MODEL=gpt-4o

# 应用 Profile:coding | automotive
MINICODER_PROFILE=coding
# 汽车意图抽取可使用更便宜、更快的独立模型；留空则复用主模型
# MINICODER_INTENT_MODEL=gpt-4o-mini
# 汽车相对时间统一按该 IANA 时区解释
MINICODER_TIMEZONE=Asia/Shanghai
# 对高确定性请求和槽位回答使用本地规则，减少额外 LLM 调用
MINICODER_INTENT_RULE_FAST_PATH=true

# --- 教学型 Mock Vehicle API（仅 automotive Profile 使用）---
MINICODER_VEHICLE_API_URL=http://127.0.0.1:8765
MINICODER_VEHICLE_API_TOKEN=local-demo-token
MINICODER_VEHICLE_API_TIMEOUT=5
# 默认拒绝连接非 localhost；接入自有远程测试服务时才显式开启
MINICODER_VEHICLE_API_ALLOW_REMOTE=false
# 车辆读取不询问；空调等控制操作按 allow | ask | deny 决策
MINICODER_VEHICLE_PERMISSION_MODE=ask
# 可选车辆白名单，逗号分隔；留空表示不按车辆 ID 限制
# MINICODER_VEHICLE_ALLOWED_IDS=A102,A103
# 仅自动化测试使用；开启后才注册 /__test__/faults 与 /__test__/reset
MINICODER_MOCK_TEST_MODE=false

# --- 本地汽车知识库（jieba + SQLite FTS5 BM25）---
# 留空使用随包发布的教学知识文档；自定义目录必须包含 manifest.json
# MINICODER_KNOWLEDGE_DIR=knowledge
MINICODER_KNOWLEDGE_INDEX=.minicoder/knowledge.db
MINICODER_KNOWLEDGE_TOP_K=5
# 启动 Automotive Profile 时根据文件哈希增量更新索引
MINICODER_KNOWLEDGE_AUTO_REBUILD=true

# 任务规划模式:rules（默认零额外调用）| hybrid（复杂意图增加一次受限 LLM 调用）
MINICODER_PLANNER_MODE=rules
# 可选独立 Planner 模型；留空复用意图模型
# MINICODER_PLANNER_MODEL=gpt-4o-mini

# Agent Loop 单次对话最大轮数(防跑飞)
MINICODER_MAX_ROUNDS=50

# 上下文窗口与为模型回答预留的 token 数
MINICODER_CONTEXT_WINDOW=128000
MINICODER_OUTPUT_RESERVE=8192

# 交互式 REPL 原子自动保存(无头 -p 模式不自动落盘)
MINICODER_AUTOSAVE=true
MINICODER_AUTOSAVE_NAME=autosave

# Provider 瞬时错误重试:默认首次请求失败后最多再试 3 次(约 1s / 2s / 4s)
MINICODER_MAX_RETRIES=3
MINICODER_RETRY_BASE_DELAY=1
MINICODER_RETRY_MAX_DELAY=8
# Retry-After 最大等待秒数
MINICODER_RETRY_MAX_WAIT=60

# 写操作权限模式:allow | ask | deny
# ask:文件写入、编辑和 Shell 执行前询问(默认)
# deny:拒绝文件写入、编辑和 Shell
# allow:无需询问;明确高危 Shell 命令仍会拒绝
# 旧值 trusted / interactive / strict 会自动迁移
MINICODER_PERMISSION_MODE=ask

# 全局只读模式:开启后无条件拒绝文件写入、编辑和 Shell
MINICODER_READ_ONLY=false
